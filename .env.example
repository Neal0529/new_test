# ETF Trading Analysis System - Environment Variables Template
# Copy this file to .env and fill in your values

# News API Configuration
# Set to 'true' to use mock news data (default), 'false' for real API
MOCK_NEWS=true

# Optional: Tushare API Token (if using real data)
# TUSHARE_TOKEN=your_token_here

# Optional: Database configuration (future use)
# DATABASE_URL=sqlite:///etf_trading.db
